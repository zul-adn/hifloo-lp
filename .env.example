# Disalin ke .env.local, lalu isi nilainya.
#
# PENTING: variabel di bawah TIDAK boleh diberi awalan NEXT_PUBLIC_.
# Awalan itu membuat nilainya ikut dikirim ke browser setiap pengunjung,
# sehingga kunci API bisa dibaca siapa saja dari bundel JavaScript.
# Formulir pendaftaran sekarang lewat /api/daftar yang berjalan di server.

# Webhook n8n yang membuat klien baru.
N8N_WEBHOOK_URL=

# Kunci API n8n. Kosongkan bila webhook tidak memintanya.
N8N_API_KEY=

# ID Google Analytics, misal G-XXXXXXXXXX.
# Kalau dikosongkan, skrip Analytics tidak dimuat sama sekali.
NEXT_PUBLIC_GA_ID=
